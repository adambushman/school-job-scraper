# Gmail SMTP. Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification; your normal account password will NOT work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com

# Comma-separated list of recipients.
EMAIL_RECIPIENTS=someone@example.com,someone-else@example.com

# Send an email even when nothing qualifies (default: false = stay silent).
SEND_WHEN_EMPTY=false

# --- Filter toggles -------------------------------------------------
INCLUDE_TEMPORARY=true
INCLUDE_KINDERGARTEN=false
INCLUDE_PRESCHOOL=false
INCLUDE_IMMERSION=false
INCLUDE_SPECIALISTS=false
INCLUDE_INTERNAL=true
